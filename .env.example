# Backend
DEEPSEEK_API_KEY=sk-your-key-here     # API_KEY is accepted as an alias
DEEPSEEK_MODEL=deepseek-chat
DEMO_MODE=false                       # true: seed data only, no network, offline LLM
DEMO_STEP_DELAY_MS=500                # pacing of the demo timeline
CORS_ORIGINS=http://localhost:3010    # comma separated
# DATA_DIR=./data                     # point at a persistent disk in production
# DATABASE_URL=sqlite:////data/tenderscout.db

# Frontend (frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8010
